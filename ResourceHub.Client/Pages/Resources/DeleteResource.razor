@page "/resources/delete/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ResourceHub.Client.Services
@using ResourceHub.Shared.DTOs
@inject AlertService Alert
@inject NavigationManager Navigation
@inject IResourceService ResourceService



@if (resource == null)
{
    <p class="loading">Loading...</p>
}
else
{
    <div class="page-header">

        <div>
            <h1 class="page-title">Delete Resource</h1>

            <p class="page-subtitle">
                Permanently remove this resource from the system
            </p>
        </div>

    </div>

    <div class="delete-card">

        <div class="warning-box">
            <h3>Warning</h3>
            <p>
                This action cannot be undone.
                All related bookings may also be affected.
            </p>
        </div>

        <div class="resource-info">

            <strong>@resource.Name</strong>

            <p>@resource.Location</p>

            <p>Capacity: @resource.Capacity</p>

            <div class="status-wrapper">
                <span class="status @(resource.IsAvailable ? "available" : "unavailable")">
                    @(resource.IsAvailable ? "Available" : "Unavailable")
                </span>
            </div>

        </div>

        <div class="actions">
            <button class="btn danger" @onclick="Delete">
                Delete Resource
            </button>

            <button class="btn secondary" @onclick="Cancel">
                Cancel
            </button>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="error">@error</p>
        }

    </div>
}

@code
{
    [Parameter] public int Id { get; set; }

    private ResourceDto? resource;

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        resource = await ResourceService.GetResourceByIdAsync(Id);
    }

    private async Task Delete()
    {
        var success = await ResourceService.DeleteResourceAsync(Id);

        if (success)
        {
            await Alert.ToastSuccess("Resource deleted successfully");
            Navigation.NavigateTo("/resources");
        }
        else
        {
            await Alert.ToastError("Failed to delete resource");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/resources");
    }
}