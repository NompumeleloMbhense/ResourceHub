@page "/resources/create"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ResourceHub.Client.Components
@using ResourceHub.Client.Services
@using ResourceHub.Shared.DTOs
@using ResourceHub.Shared.Forms
@inject IResourceService ResourceService
@inject NavigationManager Navigation



<div class="page-header">

    <div>
        <h1 class="page-title">Create Resource</h1>

        <p class="page-subtitle">
            Add a new room, workspace or shared resource
        </p>
    </div>

</div>

<div class="form-container">

    <ResourceForm Model="model" SubmitText="Create Resource" OnSubmit="HandleCreate" OnCancel="Cancel" />

    @if (!string.IsNullOrEmpty(error))
    {
        <p class="error">@error</p>
    }

</div>


@code
{
    private ResourceFormModel model = new();
    private string? error;

    private async Task HandleCreate(ResourceFormModel model)
    {
        var dto = new CreateResourceDto
        {
            Name = model.Name,
            Description = model.Description,
            Location = model.Location,
            Capacity = model.Capacity
            
        };

        var success = await ResourceService.CreateResourceAsync(dto);

        if (!success)
        {
            error = "Failed to create resource";
            return;
        }

        Navigation.NavigateTo("/resources", true);
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/resources");
    }
}
