@page "/resources"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ResourceHub.Client.Services
@using ResourceHub.Shared.DTOs
@using ResourceHub.Shared.QueryParams
@inject IResourceService ResourceService
@inject NavigationManager Navigation
@inject AlertService Alert

<div class="page-header">

    <div>
        <h1 class="page-title">Resources</h1>
        <p class="page-subtitle">
            Manage rooms, equipment, and shared resources
        </p>
    </div>

    <a href="/resources/create" class="add-btn">
        Add Resource
    </a>

</div>

<div class="toolbar">

    <input placeholder="Search name..." @bind="query.Name" class="input" />

    <input placeholder="Location..." @bind="query.Location" class="input" />

    <!-- Capacity Range -->
    <input type="number" placeholder="Min Capacity" @bind="query.MinCapacity" class="input small" />

    <input type="number" placeholder="Max Capacity" @bind="query.MaxCapacity" class="input small" />

    <!-- Availability -->
    <InputSelect TValue="bool?" @bind-Value="query.IsAvailable" class="input small">

        <option value="">All</option>
        <option value="true">Available</option>
        <option value="false">Unavailable</option>

    </InputSelect>

    <button class="btn" @onclick="Search">
        Search
    </button>

    <button class="btn secondary" @onclick="ResetFilters">
        Reset
    </button>

</div>

@if (resources == null)
{
    <p>Loading...</p>
}
else if (!resources.Any())
{
    <p>No resources found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Location</th>
                <th>Capacity</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in resources)
            {
                <tr>
                    <td>
                        <a href="@($"/resources/{r.Id}")">@r.Name</a>
                    </td>
                    <td>@r.Location</td>
                    <td>@r.Capacity</td>
                    <td>
                        <span class="status @(r.IsAvailable ? "available" : "unavailable")">
                            @(r.IsAvailable ? "Available" : "Unavailable")
                        </span>
                    </td>
                    <td>
                        <button class="btn small" @onclick="() => EditResource(r.Id)">
                            Edit
                        </button>

                        <button class="btn danger small" @onclick='() => Navigation.NavigateTo($"/resources/delete/{r.Id}")'>
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <button class="btn" @onclick="PrevPage" disabled="@(query.PageNumber == 1)">Prev</button>
        <span>Page @query.PageNumber of @totalPages</span>
        <button class="btn" @onclick="NextPage" disabled="@(query.PageNumber >= totalPages)">
            Next
        </button>
    </div>
}



@code
{
    private List<ResourceDto>? resources;
    private int totalPages;

    private ResourceQueryParams query = new();

    
    protected override async Task OnInitializedAsync()
    {
        await LoadResources();

        if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("created=true"))
        {
            await Alert.ToastSuccess("Resource created successfully");
        }
    }

    private async Task LoadResources()
    {
        var result = await ResourceService.GetResourcesAsync(query);

        if (result != null)
        {
            resources = result.Data.ToList();
            totalPages = result.TotalPages;
        }
    }

    private async Task Search()
    {
        query.PageNumber = 1;
        await LoadResources();
    }

    private async Task ResetFilters()
    {
        query = new ResourceQueryParams(); // resets everything
        await LoadResources();
    }


    private void EditResource(int id)
    {
        Navigation.NavigateTo($"/resources/edit/{id}");
    }

    private async Task NextPage()
    {
        if (query.PageNumber < totalPages)
        {
            query.PageNumber++;
            await LoadResources();
        }
    }

    private async Task PrevPage()
    {
        if (query.PageNumber > 1)
        {
            query.PageNumber--;
            await LoadResources();
        }
    }
}