@page "/"
@layout ResourceHub.Client.Layout.LandingLayout

@using ResourceHub.Client.Layout

<PageTitle>ResourceHub</PageTitle>

<div class="hero">

    <div class="hero-content">

        <h1>
            Book Shared Resources Easily
        </h1>

        <p>
            Manage meeting rooms, equipment and company resources
            from one modern dashboard.
        </p>

        <div class="hero-buttons">

            <a class="primary-btn"
               href="/login">
                Login
            </a>

            <a class="secondary-btn"
               href="/register">
                Create Account
            </a>

        </div>

    </div>

</div>