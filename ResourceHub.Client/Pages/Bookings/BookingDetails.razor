@page "/bookings/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ResourceHub.Client.Services
@using ResourceHub.Shared.DTOs
@inject IBookingService BookingService
@inject NavigationManager Navigation

<div class="page-header">
    <h3 class="page-title">Booking Details</h3>
    <p class="subtitle">View full booking information</p>
</div>

@if (booking == null)
{
    <p class="loading">Loading...</p>
}
else
{
    <div class="details-card">

        <h2 class="title">@booking.ResourceName</h2>

        <div class="details-grid">
            <div>
                <label>Booked By</label>
                <p>@booking.BookedBy</p>
            </div>

            <div>
                <label>Purpose</label>
                <p>@booking.Purpose</p>
            </div>

            <div>
                <label>Start Time</label>
                <p>@booking.StartTime.ToString("f")</p>
            </div>

            <div>
                <label>End Time</label>
                <p>@booking.EndTime.ToString("f")</p>
            </div>
        </div>

        <div class="actions">
            <button class="btn" @onclick="EditBooking">
                Edit
            </button>

            <button class="btn secondary" @onclick="GoBack">
                Back
            </button>
        </div>

    </div>
}

@code
{
    [Parameter] public int Id { get; set; }

    private BookingDto? booking;

    protected override async Task OnInitializedAsync()
    {
        booking = await BookingService.GetBookingByIdAsync(Id);
    }

    private void EditBooking()
    {
        Navigation.NavigateTo($"/bookings/edit/{booking!.Id}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/bookings");
    }
}