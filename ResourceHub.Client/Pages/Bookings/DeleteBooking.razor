@page "/bookings/delete/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ResourceHub.Client.Services
@using ResourceHub.Shared.DTOs
@inject NavigationManager Navigation
@inject IBookingService BookingService

@if (booking == null)
{
    <p class="loading">Loading...</p>
}
else
{
    <div class="page-header">

        <div>
            <h1 class="page-title">Delete Booking</h1>

            <p class="page-subtitle">
                Permanently remove this booking from the system
            </p>
        </div>

    </div>

    <div class="delete-card">

        <div class="warning-box">
            <h3>Warning</h3>
            <p>
                This action cannot be undone.
                This booking will be permanently deleted.
            </p>
        </div>

        <div class="resource-info">

            <strong>@booking.ResourceName</strong>

            <p>Booked By: @booking.BookedBy</p>

            <p>Purpose: @booking.Purpose</p>

            <p>Start: @booking.StartTime.ToString("dd/MM/yyyy HH:mm")</p>

            <p>End: @booking.EndTime.ToString("dd/MM/yyyy HH:mm")</p>

        </div>

        <div class="actions">
            <button class="btn danger" @onclick="Delete">
                Delete Booking
            </button>

            <button class="btn secondary" @onclick="Cancel">
                Cancel
            </button>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="error">@error</p>
        }

    </div>
}

@code
{
    [Parameter] public int Id { get; set; }

    private BookingDto? booking;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        booking = await BookingService.GetBookingByIdAsync(Id);
    }

    private async Task Delete()
    {
        var success = await BookingService.DeleteBookingAsync(Id);

        if (success)
        {
            Navigation.NavigateTo("/bookings", forceLoad: true);
        }
        else
        {
            error = "Failed to delete booking";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/bookings");
    }
}