@page "/bookings/create"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ResourceHub.Client.Components
@using ResourceHub.Client.Services
@using ResourceHub.Shared.DTOs
@using ResourceHub.Shared.Forms
@using ResourceHub.Shared.QueryParams
@inject IBookingService BookingService
@inject IResourceService ResourceService
@inject NavigationManager Navigation
@inject AlertService Alert



<div class="page-header">

    <div>
        <h1 class="page-title">Create Booking</h1>

        <p class="page-subtitle">
            Reserve a resource for a specific time period
        </p>
    </div>

</div>

<div class="form-container">

    @if (resources == null)
    {
        <p class="loading">Loading...</p>
    }
    else
    {
          <BookingForm Model="model"
                 Resources="resources"
                 SubmitText="Create Booking"
                 OnSubmit="HandleCreate"
                 OnCancel="Cancel"
                 OnResourceChanged="LoadBookingsForResource"
                 OnChanged="OnInputChanged" />

        
        

        @if (!string.IsNullOrEmpty(availabilityMessage))
        {
            <div class="availability-box">
                @availabilityMessage
            </div>
        }
    }

</div>

@code
{
    private BookingFormModel model = new();
    private List<ResourceDto>? resources;
    private List<BookingDto> selectedResourceBookings = new();

    private bool? isAvailable;
    private string? availabilityMessage = "";
    private bool isChecking;
   


     protected override async Task OnInitializedAsync()
    {
        var result = await ResourceService.GetResourcesAsync(new ResourceQueryParams
        {
            PageSize = 100,
            IsAvailable = true
        });

        resources = result?.Data.ToList();
    }

    private async Task HandleCreate(BookingFormModel model)
    {
        if (isAvailable == false)
        {
            await Alert.ToastError("This time slot is not available");
            return;
        }

        var dto = new CreateBookingDto
        {
            ResourceId = model.ResourceId,
            StartTime = model.StartTime,
            EndTime = model.EndTime,
            BookedBy = model.BookedBy,
            Purpose = model.Purpose
        };

        var success = await BookingService.CreateBookingAsync(dto);

        if (!success)
        {
            await Alert.ToastError("Failed to create booking");
            return;
        }

        await Alert.ToastSuccess("Booking created successfully");
        Navigation.NavigateTo("/bookings");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/bookings");
    }

    private async Task LoadBookingsForResource(int resourceId)
    {
        var result = await BookingService.GetBookingsAsync(new BookingQueryParams
        {
            ResourceId = resourceId,
            PageSize = 100
        });

        selectedResourceBookings = result?.Data.ToList() ?? new();

        await OnInputChanged();
    }


    private async Task OnInputChanged()
    {
        if (isChecking)
            return;

        if (model.ResourceId == 0 ||
            model.StartTime == default ||
            model.EndTime == default)
        {
            availabilityMessage = null;
            isAvailable = null;
            return;
        }

        isChecking = true;

        isAvailable = await BookingService.CheckAvailabilityAsync(
            model.ResourceId,
            model.StartTime,
            model.EndTime);

        availabilityMessage = isAvailable == true
            ? "Available"
            : "Not Available";

        isChecking = false;

        StateHasChanged();
    }
}