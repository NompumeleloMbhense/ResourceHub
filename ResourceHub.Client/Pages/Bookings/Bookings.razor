@page "/bookings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ResourceHub.Client.Services
@using ResourceHub.Shared.DTOs
@using ResourceHub.Shared.QueryParams
@inject IBookingService BookingService
@inject IResourceService ResourceService
@inject NavigationManager Navigation


<div class="page-header">

    <div>
        <h1 class="page-title">Bookings</h1>
        <p class="page-subtitle">Manage and track all resource bookings</p>
    </div>

    <a href="/bookings/create" class="add-btn">
        Add Booking
    </a>

</div>

<!---Resource Page Layout--->

<div class="toolbar">

    <input placeholder="Search..." @bind="query.Search" class="input" />
    <input placeholder="Booked By..." @bind="query.BookedBy" class="input" />

    <input type="date" @bind="startDate" class="input small" />
    <input type="date" @bind="endDate" class="input small" />

    <button class="btn" @onclick="Search">Search</button>
    <button class="btn secondary" @onclick="ResetFilters">Reset</button>

</div>

@if (bookings == null)
{
    <p>Loading...</p>
}
else if (!bookings.Any())
{
    <p>No bookings found.</p>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Resource</th>
                    <th>Booked By</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Purpose</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var b in bookings)
                {
                    <tr>
                        <td>
                            <a href="@($"/bookings/{b.Id}")">@b.ResourceName</a>
                        </td>
                        <td>@b.BookedBy</td>
                        <td>@b.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@b.EndTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@b.Purpose</td>

                        <td>
                            <button class="btn small" @onclick="() => EditBooking(b.Id)">
                                Edit
                            </button>

                            <button class="btn danger small" @onclick='() => Navigation.NavigateTo($"/bookings/delete/{b.Id}")'>
                                Delete
                            </button>

                            <button class="btn small warning" @onclick="() => OpenMove(b.Id)">
                                Move
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        <button class="btn" @onclick="PrevPage" disabled="@(query.PageNumber == 1)">
            Prev
        </button>

        <span>Page @query.PageNumber of @totalPages</span>

        <button class="btn" @onclick="NextPage" disabled="@(query.PageNumber >= totalPages)">
            Next
        </button>
    </div>
}

@if (showMoveModal)
{
    
    <div class="modal-overlay">
        <div class="modal-box">

            <div class="modal-header">
                <h3>Move Booking</h3>
                <button class="close-btn" @onclick="CloseMoveModal">✕</button>
            </div>

            <p>Select a new resource for this booking.</p>

            <select @bind="selectedResourceId" class="input modal-select">
                <option value="0">Select Resource</option>
                @foreach (var r in resources)
                {
                    <option value="@r.Id">@r.Name</option>
                }
            </select>

            <div class="modal-actions">
                <button class="btn secondary" @onclick="CloseMoveModal">
                    Cancel
                </button>

                <button class="btn" @onclick="ConfirmMove">
                    Confirm Move
                </button>
            </div>

        </div>
    </div>
}

@code
{
    private List<BookingDto>? bookings;
    private int totalPages;

    private BookingQueryParams query = new();

    private DateTime? startDate;
    private DateTime? endDate;

    private bool showMoveModal;
    private int selectedBookingId;
    private int selectedResourceId;

    private List<ResourceDto> resources = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadResources();
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        query.StartDate = startDate;
        query.EndDate = endDate;

        var result = await BookingService.GetBookingsAsync(query);

        if (result != null)
        {
            bookings = result.Data.ToList();
            totalPages = result.TotalPages;
        }
    }

    private async Task Search()
    {
        query.PageNumber = 1;
        await LoadBookings();
    }

    private async Task ResetFilters()
    {
        query = new BookingQueryParams();
        startDate = null;
        endDate = null;

        await LoadBookings();
    }

    private void EditBooking(int id)
        => Navigation.NavigateTo($"/bookings/edit/{id}");

    private async Task NextPage()
    {
        if (query.PageNumber < totalPages)
        {
            query.PageNumber++;
            await LoadBookings();
        }
    }

    private async Task PrevPage()
    {
        if (query.PageNumber > 1)
        {
            query.PageNumber--;
            await LoadBookings();
        }
    }

    private async Task LoadResources()
    {
        var result = await ResourceService.GetResourcesAsync(
            new ResourceQueryParams { PageSize = 100 });

        resources = result?.Data.ToList() ?? new();
    }

    private void OpenMove(int bookingId)
    {
        selectedBookingId = bookingId;
        selectedResourceId = 0;
        showMoveModal = true;
    }

    private void CloseMoveModal()
    {
        showMoveModal = false;
    }

    private async Task ConfirmMove()
    {
        if (selectedResourceId == 0) return;

        var success = await BookingService.MoveBookingAsync(
            selectedBookingId,
            selectedResourceId);

        if (success)
        {
            showMoveModal = false;
            await LoadBookings();
        }
    }
}