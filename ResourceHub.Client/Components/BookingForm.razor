@using ResourceHub.Shared.Forms
@using ResourceHub.Shared.DTOs

<EditForm Model="Model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <!-- Resource -->
    <div class="form-group">
        <label>Resource</label>
        <InputSelect @bind-Value="Model.ResourceId" 
                     @bind-Value:after="OnResourceChangedHandler" 
                     class="input">
            <option value="0">-- Select Resource --</option>
            @foreach (var r in Resources)
            {
                <option value="@r.Id">@r.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => Model.ResourceId)" />
    </div>

    <!-- Booked By -->
    <div class="form-group">
        <label>Booked By</label>
        <InputText @bind-Value="Model.BookedBy" class="input" placeholder="Enter booked by" />
        <ValidationMessage For="@(() => Model.BookedBy)" />
    </div>

    <!-- Purpose -->
    <div class="form-group">
        <label>Purpose</label>
        <InputText @bind-Value="Model.Purpose" class="input" placeholder="Enter purpose" />
        <ValidationMessage For="@(() => Model.Purpose)" />
    </div>

    <!-- Start -->
    <div class="form-group">
        <label>Start Time</label>

        <input type="datetime-local" 
               class="input @(isStartTimeInvalid ? "input-error" : "")"
               value="@StartTimeString" 
               @onchange="OnStartChanged" />

        <ValidationMessage For="@(() => Model.StartTime)" />
    </div>

    <!-- End -->
    <div class="form-group">
        <label>End Time</label>

        <input type="datetime-local" 
                class="input @(isEndTimeInvalid ? "input-error" : "")"
               value="@EndTimeString"
               @onchange="OnEndChanged" />

                @if (isEndTimeInvalid)
                {
                    <small class="field-error">
                        End time must be after start time
                    </small>
                }

        <ValidationMessage For="@(() => Model.EndTime)" />
    </div>

    <button type="submit" class="btn" disabled="@isSubmitting">@SubmitText</button>
    <button type="button" class="btn secondary" @onclick="OnCancel">Cancel</button>

</EditForm>



@code
{
    [Parameter] public BookingFormModel Model { get; set; } = new();
    [Parameter] public List<ResourceDto> Resources { get; set; } = new();

    [Parameter] public EventCallback<BookingFormModel> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<int> OnResourceChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public string SubmitText { get; set; } = "Save";

    private bool isSubmitting;

    private bool isEndTimeInvalid;
    private bool isStartTimeInvalid;

    // Validate that the end time is after the start time
    private void ValidateTimes()
    {
        if (Model.StartTime == default || Model.EndTime == default)
        {
            isEndTimeInvalid = false;
            isStartTimeInvalid = false;
            return;
        }

        if (Model.EndTime <= Model.StartTime)
        {
            isEndTimeInvalid = true;
            isStartTimeInvalid = true;
        }
        else
        {
            isEndTimeInvalid = false;
            isStartTimeInvalid = false;
        }
    }


    // Convert DateTime to string in the format required by the datetime-local input
    private string StartTimeString =>
        Model.StartTime == default ? "" : Model.StartTime.ToString("yyyy-MM-ddTHH:mm");

    private string EndTimeString =>
        Model.EndTime == default ? "" : Model.EndTime.ToString("yyyy-MM-ddTHH:mm");


    // Handles changes to the start and end time inputs, updating the model and validating 
    // the times.
    private async Task OnStartChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            Model.StartTime = date;
            ValidateTimes();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task OnEndChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            Model.EndTime = date;
            ValidateTimes();
            await OnChanged.InvokeAsync();
        }
    }


    private async Task HandleSubmit()
    {
        isSubmitting = true;
        await OnSubmit.InvokeAsync(Model);
        isSubmitting = false;
    }

    // Handles changes to the resource seclection for the booking form.
    private async Task OnResourceChangedHandler()
    {
        await OnResourceChanged.InvokeAsync(Model.ResourceId);
        await OnChanged.InvokeAsync();
    }

    
}