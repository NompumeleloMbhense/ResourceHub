@inherits LayoutComponentBase
@using ResourceHub.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="app-container">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            ResourceHub
        </div>

        <nav class="sidebar-nav">

            <NavLink class="sidebar-link" href="/" Match="NavLinkMatch.All">
                Dashboard
            </NavLink>

            <NavLink class="sidebar-link" href="/resources">
                Resources
            </NavLink>

            <NavLink class="sidebar-link" href="/bookings">
                Bookings
            </NavLink>

            <AuthorizeView Roles="Admin">
                <NavLink class="sidebar-link" href="/users">
                    Users
                </NavLink>
            </AuthorizeView>

        </nav>

    </aside>

    <!-- MAIN -->
    <div class="main">

        <!-- TOP BAR -->
        <header class="navbar">

            <div class="page-title">
                ResourceHub
            </div>

            <div class="user-section">
                <span class="user">@username</span>

                <button class="logout-btn" @onclick="Logout">
                    Logout
                </button>
            </div>

        </header>

        <!-- PAGE CONTENT -->
        <section class="content">
            @Body
        </section>

    </div>

</div>

@code
{

    private string? username;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        username = user.Identity?.IsAuthenticated == true
            ? user.Identity.Name
            : "Guest";
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();

        Navigation.NavigateTo("/login", forceLoad: true);
    }
}