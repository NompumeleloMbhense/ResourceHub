@inherits LayoutComponentBase
@using ResourceHub.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="app-container">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            ResourceHub
        </div>

        <nav class="sidebar-nav">

            <AuthorizeView>

                <Authorized>

                    <NavLink class="sidebar-link" href="/dashboard" Match="NavLinkMatch.All">
                        Dashboard
                    </NavLink>

                    <NavLink class="sidebar-link" href="/resources">
                        Resources
                    </NavLink>

                    <NavLink class="sidebar-link" href="/bookings">
                        Bookings
                    </NavLink>

                    <AuthorizeView Roles="Admin" Context="adminContext">
                        <Authorized>
                            <NavLink class="sidebar-link" href="/users">
                                Users
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>

                </Authorized>

            </AuthorizeView>

        </nav>

    </aside>

    <!-- MAIN -->
    <div class="main">

        <!-- TOP BAR -->
        <header class="navbar">

            <div class="page-title">
                ResourceHub
            </div>

            <div class="user-section">

                <AuthorizeView>

                    <Authorized>

                        <span class="user">
                            @username
                        </span>

                        <button class="logout-btn" @onclick="Logout">
                            Logout
                        </button>

                    </Authorized>

                    <NotAuthorized>

                        <button class="logout-btn" @onclick='() => Navigation.NavigateTo("/login")'>
                            Login
                        </button>

                    </NotAuthorized>

                </AuthorizeView>

            </div>

        </header>

        <!-- PAGE CONTENT -->
        <section class="content">
            @Body
        </section>

    </div>

</div>

@code
{
    private string? username;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        username = user.Identity?.IsAuthenticated == true
            ? user.Identity!.Name
            : "Guest";
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();

        Navigation.NavigateTo("/", true);
    }
}